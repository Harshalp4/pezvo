# Explicit PEZVO-approved API origin. Blank uses catalogue snapshot and disables lead submission.
# Preserve /api/services, /api/service-zones/*, /api/stores, /api/testimonials and /api/leads contracts.
NEXT_PUBLIC_PEZVO_API_BASE_URL=
# Set the verified PEZVO canonical origin only when launch is approved.
NEXT_PUBLIC_SITE_URL=
# Optional server-only brand-approved lead fallback.
PEZVO_LEAD_WEBHOOK_URL=
# Add only verified PEZVO contact/profile URLs. No legacy brand defaults.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Existing optional content/enquiry adapters; leave blank unless configured for PEZVO.
REVORA_CONTENT_FEED_URL=
REVORA_LEAD_INTAKE_URL=
REVORA_LEAD_INTAKE_KEY=
REVORA_DEFAULT_CAMPAIGN_ID=
